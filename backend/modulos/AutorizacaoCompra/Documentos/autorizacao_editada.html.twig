<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: sans-serif;
            font-size: 12px;
            line-height: 1.45;
        }

        h2:first-of-type,
        .titulo {
            color: #004085;
            border-bottom: 2px solid #004085;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        td, th {
            border: 1px solid #ccc;
            padding: 6px;
        }

        th {
            background-color: #f8f9fa;
        }

        .ql-align-center, .text-align-center { text-align: center; }
        .ql-align-right, .text-align-right { text-align: right; }
        .ql-align-justify, .text-align-justify { text-align: justify; }
    </style>
</head>
<body>
    {{ html_documento|raw }}
</body>
</html>
